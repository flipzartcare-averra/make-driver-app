PORT=4000
JAVA_FARE_SERVICE_URL=http://localhost:8080/api/fare/calculate

# Local single-node dev: mongodb://localhost:27017/averra
# Replica set / Atlas: mongodb+srv://user:pass@cluster.mongodb.net/averra?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/averra
MONGODB_MAX_POOL_SIZE=20

# Required — the server refuses to start without this. Generate a real
# random value for production, e.g.: openssl rand -hex 32
JWT_SECRET=

# Only used by `npm run create-admin` when run with no arguments — see
# the "Admin panel" section in README.md.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Restrict in production to your deployed frontend's URL. Left unset,
# allows all origins — fine for local dev only.
ALLOWED_ORIGIN=

# Optional — push notifications (booking status changes) silently no-op
# without this. From Firebase Console → Project settings → Service
# accounts → Generate new private key, then base64-encode the whole
# downloaded JSON file into one line:
#   base64 -i serviceAccountKey.json | tr -d '\n'
# (macOS: base64 -i file; Linux: base64 -w0 file)
FIREBASE_SERVICE_ACCOUNT=

# Optional — auto-calculates distance between pickup/drop in the booking
# form. Without this, distance stays manually entered (no error shown to
# riders, it just doesn't auto-fill). From console.cloud.google.com:
# create/select a project, enable the "Distance Matrix API", create an
# API key. This is called server-to-server, so restrict the key by IP
# (your backend's outbound IP) rather than HTTP referrer — and never put
# this key in frontend code, only here. Billable beyond Google's free
# tier; results between the same two places are cached for 30 days to
# limit real-world cost.
GOOGLE_MAPS_API_KEY=

# Optional — shared cache and rate-limit store, only matters once you're
# running more than one Node instance behind a load balancer. Without
# this, each instance caches and rate-limits independently (see
# services/redisClient.js for exactly what that means in practice).
# Local dev: redis://localhost:6379 — managed: Upstash, Redis Cloud, or
# your host's own Redis add-on.
REDIS_URL=

# Optional — enables the "pay 20% advance" option after a booking (the
# homepage trust badge already promises this; without these keys the
# option just doesn't appear, booking itself still works). From the
# Razorpay dashboard: Settings → API Keys. Test mode keys work
# identically to live ones for development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — enables "Continue with Google" in the Driver app. Create an
# OAuth 2.0 *Web* client ID in Google Cloud Console (APIs & Services →
# Credentials) and paste it here; the same Web client ID is passed to the
# Flutter driver app as GOOGLE_SERVER_CLIENT_ID. Email/password sign-up
# works without it.
GOOGLE_CLIENT_ID=
